{
    "name": "Kahuna, the IndexedDB-Manager",
    "short_name": "Kahuna",
    "version": "1.6.2",
    "description": "Browse, manage and edit IndexedDB databases.",
    "author":"Lutz Brückner",
    "homepage_url":"https://github.com/hummingme/kahuna#readme",
    "manifest_version": 2,
    "icons": {
        "48": "icons/kahuna.svg",
        "96": "icons/kahuna.svg"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [{
        "matches": ["*://*/*"],
        "js": ["contentscript.js"]
    }],
    "permissions": [
        "*://*/*",
        "scripting"
    ],
    "browser_action": {
        "default_icon": {
            "16": "icons/kahuna-gray-16.png",
            "32": "icons/kahuna-gray-32.png",
            "48": "icons/kahuna-gray-48.png"
        },  
        "default_title": "Kahuna: Can't run on restricted pages."
    },
    "commands": {
        "_execute_browser_action": {
            "suggested_key": {
                "default": "Ctrl+Period",
                "mac": "Command+Period"
            }
        }
    },
    "web_accessible_resources": [
        "kahuna.js",
        "code_worker.js",
        "contentscript_worker.js",
        "injected_export_import.js",
        "icons/kahuna.svg",
        "icons/kahuna-16.png",
        "icons/kahuna-32.png",
        "icons/kahuna-48.png",
        "static/kahuna.css",
        "static/icons.svg"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "dev@kahuna.rocks",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
